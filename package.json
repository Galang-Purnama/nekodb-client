    },
    "bugs": {
        "url": "https://github.com/Galang-Purnama/nekodb-client/issues"
    },
    "homepage": "https://github.com/Galang-Purnama/nekodb-client",
    "dependencies": {
        "ws": "^8.16.0"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "auth/",
        "middleware/",
        "query/",
        "schema/",
        "events/",
        "helpers/",
